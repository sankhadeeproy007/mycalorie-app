GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-flash-latest)
GEMINI_MODEL=
# Access code for the unlock screen: 4–8 digits. Change it to sign every device out.
ACCESS_CODE=
# Other people, each with their own data: name:code pairs, codes the same length as ACCESS_CODE.
# e.g. priya:48291736,rahul:20556611 — changing someone's code signs only them out.
ACCESS_CODES=
# Long random string that signs sessions, e.g. from: openssl rand -hex 32
SESSION_SECRET=
# Optional: Claude for "Try Claude" on photos (and npm run compare). CLAUDE_EFFORT: low (default) | medium | high.
ANTHROPIC_API_KEY=
CLAUDE_EFFORT=
# Optional cloud sync. Vercel's Redis integration sets REDIS_URL; Upstash's sets the KV_REST_API_* pair.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
